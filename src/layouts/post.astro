---
import Layout from "./main.astro";
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main
    class="relative z-30 max-w-4xl pb-1 mx-auto mt-10 bg-white dark:bg-neutral-950 md:rounded-t-md text-neutral-900"
  >
    <div
      class="relative flex flex-col px-5 pt-6 border-t border-b-0 md:border-r md:border-l md:pt-20 lg:px-0 justify-stretch md:rounded-t-2xl border-neutral-200 dark:border-neutral-800"
    >
      <div
        class="absolute top-0 left-0 hidden w-px h-full mt-1 -translate-x-px md:block bg-gradient-to-b from-transparent to-white dark:to-neutral-950"
      >
      </div>
      <div
        class="absolute top-0 right-0 hidden w-px h-full mt-1 translate-x-px md:block bg-gradient-to-b from-transparent to-white dark:to-neutral-950"
      >
      </div>
      <h1
        class="w-full max-w-2xl mx-auto text-3xl font-bold leading-tight tracking-tighter text-left md:mb-12 md:text-4xl dark:text-neutral-100 lg:text-5xl md:leading-none"
      >
        {frontmatter.title}
      </h1>
    </div>

    {frontmatter.isUnderConstruction ? (
      <article
        class="w-full max-w-2xl mx-auto mb-20 px-7 lg:px-0"
      >
        <div class="flex flex-col items-center justify-center py-20 text-center">
          <div class="mb-8 text-8xl">🚧</div>
          <h2 class="mb-4 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
            Under Construction
          </h2>
          <p
            id="construction-message"
            class="text-lg text-neutral-600 dark:text-neutral-400 max-w-md"
          >
            This blog is currently under construction, please come back sometime in the future.
          </p>
        </div>
        <script>
          const quotes = [
            "Thanks for stopping by. This page isn't ready yet, but it will be soon.",
            "This page is under construction, but you're early in the best way.",
            "Still working on turning thoughts into something worth reading.",
            "Still underwater collecting memories. This page will surface soon.",
            "Still unpacking memories from the road. This page will be ready soon.",
            "Memories loading. Please check back soon.",
          ];
          const messageElement = document.getElementById("construction-message");
          if (messageElement) {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            messageElement.textContent = randomQuote;
          }
        </script>
      </article>
    ) : (
      <article
        class="w-full max-w-2xl mx-auto mb-20 prose-sm prose px-7 lg:px-0 lg:prose-lg dark:prose-invert"
      >
        <slot />
      </article>
    )}
  </main>
</Layout>
